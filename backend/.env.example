# Copie este arquivo para "backend/.env" e preencha o que precisar, para
# rodar o projeto localmente (`npm start` na raiz do repositório).
#
# Em produção (Vercel), estas variáveis são configuradas em
# Project Settings > Environment Variables — este arquivo não é lido lá.

PORT=3000

# --- Banco de dados e imagens (obrigatórios) ---
# Preenchidos automaticamente na Vercel quando você conecta os storages
# Postgres e Blob ao projeto (aba Storage). Para rodar localmente contra o
# mesmo banco/blob de produção, copie os valores de lá (Storage > .env.local)
# para cá, ou use `vercel env pull backend/.env` se tiver o Vercel CLI.
POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=

# Assina o cookie de login. O servidor gera um sozinho na primeira vez que
# roda localmente (grava aqui automaticamente) — só é obrigatório definir
# manualmente em produção na Vercel.
JWT_SECRET=

# Endereço público do site. Usado para montar o link de recuperação de senha
# e as meta tags de prévia de link (og:image/og:url) da rota GET /item/:id —
# troque para o domínio real assim que a loja for publicada, senão as
# prévias de link compartilhado apontam para localhost.
BASE_URL=http://localhost:3000

# Código de convite exigido para criar uma NOVA conta no painel depois que
# a primeira já existir (a primeira conta, criada pela aba "Criar conta",
# não precisa de código). Defina algo só seu e compartilhe apenas com quem
# for ajudar a cadastrar itens.
SIGNUP_CODE=

# Marca os cookies (login do painel e o de visitante anônimo) como
# "secure", enviados só em HTTPS. Deixe "false" em desenvolvimento local
# (http://localhost não é HTTPS — com "true" aqui o login pararia de
# funcionar). Na Vercel isso é ligado automaticamente (detecta o ambiente),
# não precisa mexer aqui para produção.
COOKIE_SECURE=false

# --- E-mail de recuperação de senha (opcional) ---
# Sem isso configurado, o link de "esqueci minha senha" só aparece no
# console onde o servidor está rodando (funciona bem para uso local).
# Para enviar e-mail de verdade usando uma conta do Gmail:
#   1. Ative a verificação em duas etapas na conta Google.
#   2. Crie uma "senha de app" em https://myaccount.google.com/apppasswords
#   3. Preencha os campos abaixo com esse e-mail e a senha de app gerada
#      (não é a senha normal da conta Google).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Resumo diário por e-mail (opcional, só funciona rodando localmente) ---
# Se "true", o servidor manda todo dia às 08:00 um e-mail com o resumo do
# dia anterior (visitas na vitrine + cliques em "Comprar no WhatsApp") para
# o e-mail de cada conta cadastrada no painel. Usa o mesmo SMTP configurado
# acima; sem SMTP configurado, o resumo só aparece no console do servidor.
# Limitação: depende de um processo Node rodando continuamente nesse
# horário — não funciona na Vercel (função serverless não fica "de pé"),
# só em desenvolvimento local.
DAILY_SUMMARY_EMAIL=false
